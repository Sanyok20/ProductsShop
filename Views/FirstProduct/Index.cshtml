@model Products.Models.Product

@{
    ViewData["Title"] = "Перший товар з бази даних";
}

<div>
    <h2 class="text-center">Перший товар з бази даних</h2>
    <div class="container">
        @if(Model != null)
        {   
            <div class="row">
                <div class="p-3 col-3">
                    <div class="card">
                        <div class="text-center">
                            <img src="@(Model.Image ?? "/images/categories/products/default1.jpg")" alt="@Model.Name" style="object-fit: contain; height: 175px; background-color: #bbbbbb;" class="w-100" />
                        </div>
                        <h3 class="card-header">@Model.Name</h3>
                        <div class="card-body">
                            <p class="card-text">@Model.Description</p>
                            <p class="card-text">Екран: 6.67 дюйма, IPS LCD, роздільна здатність 2400 × 1080 (Full HD+), щільність 393 ppi.</p>
                            <p class="card-text">Процесор: 8-ядерний HiSilicon Kirin 710A (14 нм), графіка Mali-G51 MP4.</p>
                            <p class="card-text">Пам'ять: 4 ГБ оперативної (RAM) та 128 ГБ вбудованої (ROM), окремий слот для microSD до 512 ГБ.</p>
                            <p class="card-text">Акумулятор: 5000 мА·год, швидка зарядка SuperCharge на 22.5 Вт.</p>
                            <p class="card-text">ОС: Android 10 з оболонкою Magic UI 3.1 (без сервісів Google, використовуються Huawei Mobile Services).</p>
                            <p class="card-text">Розміри та вага: 165.7 × 77 × 9.26 мм, 206 г.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <h3 class="text-center">Не вдалося знайти товар</h3>
        }
    </div>
</div>