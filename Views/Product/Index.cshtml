@model IEnumerable<Product>

@{
    ViewData["Title"] = "Товари";
}

<div>
    <h2 class="text-center">Товари</h2>
    <div class="container">
        @if(Model.Any())
        {   
            <div class="row">
                @foreach(var product in Model)
                {
                        <div class="p-3 col-3">
                        <div class="card">
                            <div class="text-center">
                                <img src="@product.Image" alt="@product.Name" style="object-fit: contain; height: 175px; background-color: #bbbbbb;" class="w-100" />
                            </div>
                            <h3 class="card-header">@product.Name</h3>
                            <div class="card-body">
                                <p class="card-text">@product.Description</p>
                            </div>
                        </div>
                    </div>                
                }
            </div>
        }
        else
        {
            <h3 class="text-center">Не вдалося знайти товари</h3>
        }
    </div>
</div>