@model IEnumerable<Product>

@{
    ViewData["Title"] = "Перший товар з бази даних";
}

<div>
    <h2 class="text-center">Перший товар з бази даних</h2>
    <div class="container">
        @if(Model.Any())
        {   
            <div class="row">
                @foreach(var product in Model)
                {
                    <div class="p-3 col-3">
                        <div class="card">
                            <div class="text-center">
                                <img src="@product.Image" alt="@product.Name" style="object-fit: contain; height: 175px; background-color: #bbbbbb;" class="w-100" />
                            </div>
                            <h3 class="card-header">@product.Name</h3>
                            <div class="card-body">
                                <p class="card-text">@product.Description</p>
                                <p class="card-text">Екран: 5,45 дюйма, IPS, роздільна здатність 1440x720 пікселів.</p>
                                <p class="card-text">Пам'ять: 6 ГБ оперативної пам'яті (ОЗУ) та 128 ГБ вбудованої пам'яті.</p>
                                <p class="card-text">Процесор: MediaTek Helio G35 (MT6765G).</p>
                                <p class="card-text">Акумулятор: 6600 мА·год.</p>
                                <p class="card-text">Захист: Стандарти IP68, IP69K та військовий MIL-STD-810G (захист від води, пилу та ударів).</p>
                                <p class="card-text">Особливість: У верхній частині корпусу розміщені TWS-навушники, які заряджаються прямо всередині телефону.</p>
                            </div>
                            
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <h3 class="text-center">Не вдалося знайти товар</h3>
        }
    </div>
</div>