@model ProductCreateVM

@{
    ViewData["Title"] = "Новий товар";
}

<div>
    <h2 class="text-center">Новий товар</h2>
    <form 
        enctype="multipart/form-data"
        method="post"
        asp-controller="Product"
        asp-action="Create"
        class="m-auto border p-5 rounded-2 mt-3" 
        style="width: 35%;">
        @* Name *@
        <div>
            <label for="name" class="form-label">Назва</label>
            <input asp-for="Name" class="form-control" id="name">
            <span asp-validation-for="Name" class="form-text text-danger"></span>
        </div>

        @* Price *@
        <div>
            <label for="price" class="form-label">Ціна</label>
            <input asp-for="Price" class="form-control" id="price">
        </div>

        @* Image *@
        <div class="mt-4">
            <label for="image" class="form-label">Зображення</label>
            <input type="file" accept="image/*" asp-for="Image" class="form-control" id="image">
        </div>

        @* Description *@
        <div class="mt-4">
            <label for="description" class="form-label">Опис</label>
            <input asp-for="Description" class="form-control" id="description">
        </div>

         @* Category *@
        <div class="mt-3">
            <label asp-for="CategoryId" class="form-label">Категорія</label>
            <input asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <span asp-validation-for="CategoryId" class="form-text text-danger"></span>
</div>

        <div class="mt-4 w-50 m-auto">
            <input type="submit" class="btn btn-success w-100" value="Додати" />
        </div>
    </form>
</div>