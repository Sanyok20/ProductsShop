@model CategoryUpdateVM

@{
    ViewData["Title"] = "Редагування категорії";
}

<div>
    <h2 class="text-center">Редагування категорії</h2>
    <form method="post"
          enctype="multipart/form-data"
          asp-controller="Category"
          asp-action="Update"
          class="m-auto border p-5 rounded-2 mt-3"
          style="width: 35%;">
        @* Name *@
        <div>
            <label for="name" class="form-label">Назва</label>
            <input asp-for="Name" class="form-control" id="name">
            <span asp-validation-for="Name" class="form-text text-danger"></span>
        </div>

        @* Description *@
        <div class="mt-4">
            <label for="description" class="form-label">Опис</label>
            <input asp-for="Description" class="form-control" id="description">
        </div>

        @* Image *@
        <div class="mt-4">
            <label for="image" class="form-label">Зображення</label>
            <input asp-for="Image" type="file" accept="image/*" class="form-control" id="image">
        </div>

        <div class="mt-4 w-50 m-auto">
            <input type="submit" class="btn btn-success w-100" value="Зберегти" />
        </div>
    </form>
</div>